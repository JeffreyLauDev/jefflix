{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jefflix",
  "version": "2.1.0",
  "identifier": "com.jeffrey.jefflix.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npx expo export -p web"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Jefflix", "width": 1280, "height": 760, "minWidth": 800, "minHeight": 480, "backgroundColor": "#000000", "center": true, "backgroundThrottling": "disabled" }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Entertainment",
    "shortDescription": "Jefflix — Jellyfin player",
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
